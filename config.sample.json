{
  "DumpPath": "D:\\DUMPS\\sample.dmp",
  "BaselineDumpPath": null,
  "TrendDumpPaths": [],
  "Profile": "balanced",
  "IncludeAnalyzers": [ "MemoryLeak", "ReferenceChain" ],
  "ExcludeAnalyzers": [ "Thread" ],
  "CacheDirectory": null,
  "ReportFormat": "html",
  "ReportStyleVersion": "v1",
  "Diagnostics": {
    "EnableMemoryDiagnostics": false,
    "EnablePerformanceDiagnostics": false,
    "CollectAfterAnalyzerRun": false,
    "CollectAfterAnalyzerRunEveryKAnalyzers": 0,
    "CollectAfterAnalyzerRunWorkingSetThresholdBytes": 0,
    "CompactLargeObjectHeapAfterAnalyzerCollection": true
  },
  "Analyzers": {
    "MemoryLeak": {
      "Profile": "fast",
      "HighReferenceThreshold": 100
    },
    "ReferenceChain": {
      "TopCount": 10
    }
  },
  "Indexing": {
    "Mode": "auto"
  },
  "ExecutionPolicy": {
    "MaxLeakScanObjects": 2000000,
    "MaxReferenceAddresses": 1000000,
    "ReferenceChainMaxPathDepth": 25,
    "ReferenceChainFastModeMaxDepth": 25,
    "ReferenceChainMaxPathSearchObjects": 5000,
    "IndexPrebuildMode": "auto"
  }
}
