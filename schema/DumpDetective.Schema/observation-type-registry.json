{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dumpdetective/schema/observation-type-registry.json",
  "registryVersion": "1.16.0",
  "description": "Canonical ObservationType namespace. Observation.ObservationType (src/DumpDetective.Sdk/Observations/Observation.cs) is a free-form string, not an enum, by design (docs/refactor/modularity/observation-and-correlation-model.md § 7 keeps it open until enough producers exist to justify closing it) — this registry is the checked-in record of every type actually emitted today, so a typo or a silent rename is a diffable, reviewable event instead of an invisible string drift. Cross-checked against real analyzer output by tests/DumpDetective.Tests/Unit/Architecture/SdkRegistryConformanceTests.cs. Purity rules for every entry's measures (raw only, never a severity/weighted composite) are in Observation.cs's own remarks and observation-and-correlation-model.md § 2a.",
  "observationTypes": {
    "gc.pause": {
      "producedBy": "GcPauseAnalyzer",
      "sourceFile": "src/DumpDetective.Sources.NetTrace/GcPauseAnalyzer.cs",
      "requiresCapabilities": ["trace.gc-events"],
      "subjectKind": "thread",
      "temporalKind": "interval",
      "measures": {
        "gc.suspend-reason": { "unit": "custom", "semantics": "absolute" },
        "pause.duration": { "unit": "milliseconds", "semantics": "duration" },
        "gc.generation": { "unit": "count", "semantics": "absolute" },
        "heap.size": { "unit": "bytes", "semantics": "absolute" }
      },
      "addedIn": "1.0.0"
    },
    "contention.episode": {
      "producedBy": "ContentionAnalyzer",
      "sourceFile": "src/DumpDetective.Sources.NetTrace/ContentionAnalyzer.cs",
      "requiresCapabilities": ["trace.contention-events"],
      "subjectKind": "thread",
      "temporalKind": "interval",
      "measures": {
        "contention.duration": { "unit": "milliseconds", "semantics": "duration" }
      },
      "note": "Named 'contention.episode', not the earlier design table's 'contention.hotspot' — 'hotspot' is a ranking/severity claim, which observation purity rules push to a synthesis rule (Phase 5, not yet built) instead. See the analyzer's own remarks.",
      "addedIn": "1.0.0"
    },
    "cpu.sample-attribution": {
      "producedBy": "CpuHotspotAnalyzer",
      "sourceFile": "src/DumpDetective.Sources.NetTrace/CpuHotspotAnalyzer.cs",
      "requiresCapabilities": ["trace.cpu-samples"],
      "subjectKind": "method",
      "temporalKind": "interval",
      "measures": {
        "cpu.sample-count": { "unit": "count", "semantics": "absolute" }
      },
      "note": "Named 'cpu.sample-attribution', not 'cpu.hotspot', same reasoning as contention.episode above. Leaf-frame-only (exclusive samples), not an inclusive call-tree breakdown — see the analyzer's own remarks.",
      "addedIn": "1.0.0"
    },
    "heap.root": {
      "producedBy": "GCRootAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Gc/Analyzers/GCRootAnalyzer.cs",
      "requiresCapabilities": ["heap.roots", "heap.objects", "heap.segments", "heap.types"],
      "subjectKind": "type",
      "temporalKind": "point",
      "measures": {
        "retained.bytes": { "unit": "bytes", "semantics": "absolute" },
        "subgraph.node-count": { "unit": "count", "semantics": "absolute" }
      },
      "note": "Phase 5 step 1's pilot analyzer (docs/refactor/modularity/phase-5-observations-synthesis.md). One observation per RootFinding — no root-kind measure yet, see the analyzer's own EmitObservationsAsync remarks for why.",
      "addedIn": "1.1.0"
    },
    "handle.pinned": {
      "producedBy": "GCHandleAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Gc/Analyzers/GCHandleAnalyzer.cs",
      "requiresCapabilities": ["heap.handles", "heap.objects", "heap.segments"],
      "subjectKind": "type",
      "temporalKind": "point",
      "measures": {
        "retained.bytes": { "unit": "bytes", "semantics": "absolute" }
      },
      "note": "One observation per already-bounded GCHandleDomainResult.TopPinnedHandleAddresses entry, not per handle.",
      "addedIn": "1.2.0"
    },
    "finalizer.queue-entry": {
      "producedBy": "FinalizableObjectAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Gc/Analyzers/FinalizableObjectAnalyzer.cs",
      "requiresCapabilities": ["heap.finalizer-queue", "heap.segments", "heap.types"],
      "subjectKind": "type",
      "temporalKind": "point",
      "measures": {
        "retained.bytes": { "unit": "bytes", "semantics": "absolute" },
        "disposed-but-live": { "unit": "count", "semantics": "absolute" }
      },
      "note": "One observation per valid finalizer-queue entry (the whole queue, uncapped by design — see the analyzer's own remarks).",
      "addedIn": "1.3.0"
    },
    "weakhandle.target": {
      "producedBy": "WeakReferenceAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Gc/Analyzers/WeakReferenceAnalyzer.cs",
      "requiresCapabilities": ["heap.handles", "heap.segments", "heap.objects"],
      "subjectKind": "type",
      "temporalKind": "point",
      "measures": {
        "retained.bytes": { "unit": "bytes", "semantics": "absolute" }
      },
      "note": "One observation per alive weak-handle target (Phase A). retained.bytes is omitted, not zeroed, when no dominator tree is available.",
      "addedIn": "1.4.0"
    },
    "weakreference.stale-wrapper": {
      "producedBy": "WeakReferenceAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Gc/Analyzers/WeakReferenceAnalyzer.cs",
      "requiresCapabilities": ["heap.objects", "dump.object-fields"],
      "subjectKind": "type",
      "temporalKind": "point",
      "measures": {
        "shallow.bytes": { "unit": "bytes", "semantics": "absolute" }
      },
      "note": "One observation per WeakReference<T> instance whose m_handle field reads 0 (Phase B) — only the stale subset, not every WeakReference<T> instance.",
      "addedIn": "1.4.0"
    },
    "gc.generation-composition": {
      "producedBy": "GCGenerationAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Memory/Analyzers/GCGenerationAnalyzer.cs",
      "requiresCapabilities": ["heap.types"],
      "subjectKind": null,
      "temporalKind": "point",
      "measures": {
        "gen0.bytes": { "unit": "bytes", "semantics": "absolute" },
        "gen1.bytes": { "unit": "bytes", "semantics": "absolute" },
        "gen2.bytes": { "unit": "bytes", "semantics": "absolute" },
        "loh.bytes": { "unit": "bytes", "semantics": "absolute" },
        "poh.bytes": { "unit": "bytes", "semantics": "absolute" },
        "gen2.fraction": { "unit": "ratio", "semantics": "ratio" },
        "loh.fraction": { "unit": "ratio", "semantics": "ratio" }
      },
      "note": "Single whole-heap observation per run — the canonical gc.generation-composition example named in observation-and-correlation-model.md § 2a. No entity subject (whole-process scalar). Per-type breakdown deliberately deferred (unbounded volume risk).",
      "addedIn": "1.5.0"
    },
    "gc.allocation-composition": {
      "producedBy": "AllocationPatternAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Memory/Analyzers/AllocationPatternAnalyzer.cs",
      "requiresCapabilities": ["heap.types"],
      "subjectKind": null,
      "temporalKind": "point",
      "measures": {
        "gen0.count-fraction": { "unit": "ratio", "semantics": "ratio" },
        "gen1.count-fraction": { "unit": "ratio", "semantics": "ratio" },
        "gen2.count-fraction": { "unit": "ratio", "semantics": "ratio" },
        "loh.count-fraction": { "unit": "ratio", "semantics": "ratio" },
        "finalizable.type-count": { "unit": "count", "semantics": "absolute" },
        "finalizable.bytes": { "unit": "bytes", "semantics": "absolute" }
      },
      "note": "Count-based whole-heap composition, distinct from GCGenerationAnalyzer's byte-based gc.generation-composition — independent corroborating measurement, not duplication (observation-and-correlation-model.md § 4). Excludes AllocationProfile and the four Top*Types lists (Smell B — bucketed by a hand-picked threshold, not a raw fact).",
      "addedIn": "1.6.0"
    },
    "heap.segment-composition": {
      "producedBy": "MemoryAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Memory/Analyzers/MemoryAnalyzer.cs",
      "requiresCapabilities": ["heap.segments"],
      "subjectKind": null,
      "temporalKind": "point",
      "measures": {
        "generation.ordinal": { "unit": "custom", "semantics": "absolute" },
        "committed.bytes": { "unit": "bytes", "semantics": "absolute" },
        "reserved.bytes": { "unit": "bytes", "semantics": "absolute" },
        "used.bytes": { "unit": "bytes", "semantics": "absolute" },
        "segment.count": { "unit": "count", "semantics": "absolute" }
      },
      "note": "One observation per generation label (bounded to at most 6). No segment entity kind exists yet, so generation.ordinal carries which row this is, same convention as gc.suspend-reason.",
      "addedIn": "1.7.0"
    },
    "heap.loh-fragmentation": {
      "producedBy": "LohFragmentationAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Memory/Analyzers/LohFragmentationAnalyzer.cs",
      "requiresCapabilities": ["heap.segments"],
      "subjectKind": null,
      "temporalKind": "point",
      "measures": {
        "kind.ordinal": { "unit": "custom", "semantics": "absolute" },
        "segment.count": { "unit": "count", "semantics": "absolute" },
        "total.bytes": { "unit": "bytes", "semantics": "absolute" },
        "free.bytes": { "unit": "bytes", "semantics": "absolute" },
        "used.bytes": { "unit": "bytes", "semantics": "absolute" },
        "fragmentation.percent": { "unit": "percent", "semantics": "ratio" },
        "largest-free-block.bytes": { "unit": "bytes", "semantics": "absolute" }
      },
      "note": "One observation per LOH/POH kind breakdown row (bounded to at most 2: Large, Pinned).",
      "addedIn": "1.8.0"
    },
    "heap.loh-type-composition": {
      "producedBy": "LohFragmentationAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Memory/Analyzers/LohFragmentationAnalyzer.cs",
      "requiresCapabilities": ["heap.segments", "heap.types"],
      "subjectKind": "type",
      "temporalKind": "point",
      "measures": {
        "loh.count": { "unit": "count", "semantics": "absolute" },
        "loh.bytes": { "unit": "bytes", "semantics": "absolute" }
      },
      "note": "One observation per type that actually has LOH objects — bounded to a small fraction of the whole-heap type population, unlike GCGenerationAnalyzer's per-type list.",
      "addedIn": "1.9.0"
    },
    "heap.segment-reservation": {
      "producedBy": "SegmentReservationAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Memory/Analyzers/SegmentReservationAnalyzer.cs",
      "requiresCapabilities": ["heap.segments"],
      "subjectKind": null,
      "temporalKind": "point",
      "measures": {
        "committed.bytes": { "unit": "bytes", "semantics": "absolute" },
        "reserved.bytes": { "unit": "bytes", "semantics": "absolute" },
        "reservation-gap.bytes": { "unit": "bytes", "semantics": "absolute" },
        "reserved-to-committed.ratio": { "unit": "ratio", "semantics": "ratio" },
        "ephemeral.segment-count": { "unit": "count", "semantics": "absolute" },
        "ephemeral.avg-fill-percent": { "unit": "percent", "semantics": "ratio" },
        "segment.count": { "unit": "count", "semantics": "absolute" }
      },
      "note": "Single whole-heap observation per run. Excludes AddressSpacePressureRisk/PressureRiskReason — a hand-picked-threshold classification (Smell A).",
      "addedIn": "1.10.0"
    },
    "heap.region-composition": {
      "producedBy": "SegmentReservationAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Memory/Analyzers/SegmentReservationAnalyzer.cs",
      "requiresCapabilities": ["heap.segments"],
      "subjectKind": null,
      "temporalKind": "point",
      "measures": {
        "region-kind.ordinal": { "unit": "custom", "semantics": "absolute" },
        "region.count": { "unit": "count", "semantics": "absolute" },
        "reserved.bytes": { "unit": "bytes", "semantics": "absolute" },
        "committed.bytes": { "unit": "bytes", "semantics": "absolute" },
        "near-empty.count": { "unit": "count", "semantics": "absolute" },
        "near-empty.committed-bytes": { "unit": "bytes", "semantics": "absolute" }
      },
      "note": "One observation per region-generation bucket (bounded to at most 7), only emitted when the dump is regions-based (.NET 9+ GC).",
      "addedIn": "1.11.0"
    },
    "thread.blocked": {
      "producedBy": "LockGraphAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Threads/Analyzers/LockGraphAnalyzer.cs",
      "requiresCapabilities": ["runtime.locks", "heap.objects", "runtime.threads"],
      "subjectKind": "thread",
      "temporalKind": "point",
      "measures": {
        "locks-held.count": { "unit": "count", "semantics": "absolute" }
      },
      "note": "One per deadlock-candidate thread (alive, holds a lock, blocked on a monitor). Named for the canonical example in observation-and-correlation-model.md § 4 — 'deadlock' is a synthesis-rule judgment, not this raw fact.",
      "addedIn": "1.12.0"
    },
    "lock.contested": {
      "producedBy": "LockGraphAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Threads/Analyzers/LockGraphAnalyzer.cs",
      "requiresCapabilities": ["runtime.locks", "heap.objects", "runtime.threads"],
      "subjectKind": "type",
      "temporalKind": "point",
      "measures": {
        "waiting.count": { "unit": "count", "semantics": "absolute" },
        "recursion.count": { "unit": "count", "semantics": "absolute" }
      },
      "note": "One per contested lock. Subjects carries the lock's type, plus the owning thread as a second subject when resolved (a relation, per observation-and-correlation-model.md § 1's Subjects remarks).",
      "addedIn": "1.13.0"
    },
    "thread.wait-state": {
      "producedBy": "HangAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Threads/Analyzers/HangAnalyzer.cs",
      "requiresCapabilities": ["runtime.threads"],
      "subjectKind": "thread",
      "temporalKind": "point",
      "measures": {
        "locks-held.count": { "unit": "count", "semantics": "absolute" }
      },
      "note": "One per alive thread that is actually waiting — a proper subset of all alive threads. WaitType/WaitReason omitted (categorical, no enum instance left in scope by the time the domain result exists).",
      "addedIn": "1.14.0"
    },
    "thread.state": {
      "producedBy": "ThreadAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Threads/Analyzers/ThreadAnalyzer.cs",
      "requiresCapabilities": ["runtime.threads"],
      "subjectKind": "thread",
      "temporalKind": "point",
      "measures": {
        "stack-size.bytes": { "unit": "bytes", "semantics": "absolute" },
        "locks-held.count": { "unit": "count", "semantics": "absolute" },
        "stack-root.count": { "unit": "count", "semantics": "absolute" },
        "has-exception": { "unit": "count", "semantics": "absolute" },
        "async-chain.depth": { "unit": "count", "semantics": "absolute" }
      },
      "note": "One per alive thread — bounded by real thread count, never heap-scale.",
      "addedIn": "1.15.0"
    },
    "thread.stack-cluster": {
      "producedBy": "ThreadStackClusterAnalyzer",
      "sourceFile": "src/DumpDetective.Plugins.Threads/Analyzers/ThreadStackClusterAnalyzer.cs",
      "requiresCapabilities": ["runtime.threads"],
      "subjectKind": null,
      "temporalKind": "point",
      "measures": {
        "cluster.count": { "unit": "count", "semantics": "absolute" },
        "threadpool-worker.count": { "unit": "count", "semantics": "absolute" },
        "gc.count": { "unit": "count", "semantics": "absolute" },
        "finalizer.count": { "unit": "count", "semantics": "absolute" }
      },
      "note": "One per distinct call-stack-shape cluster among alive threads (filtered by MinClusterSize). No entity subject — a cluster spans many threads; SampleOsThreadIds is a sample, not full membership.",
      "addedIn": "1.16.0"
    }
  }
}
