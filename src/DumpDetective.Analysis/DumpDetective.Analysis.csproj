<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DumpDetective.Analysis</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Configuration\**" />
    <EmbeddedResource Remove="Configuration\**" />
    <None Remove="Configuration\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\DumpDetective.Reporting\FindingGenerators\*.cs" Link="FindingGenerators\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.7" />
    <ProjectReference Include="..\DumpDetective.Core\DumpDetective.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DumpDetective.Cli" />
    <InternalsVisibleTo Include="DumpDetective.Reporting" />
    <InternalsVisibleTo Include="DumpDetective.Tests" />
    <InternalsVisibleTo Include="BenchmarkSuite1" />
  </ItemGroup>
</Project>
