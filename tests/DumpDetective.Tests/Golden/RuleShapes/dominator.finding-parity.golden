rule: dominator.finding-parity
version: 2
[
  {
    "name": "critical-retention-with-complete-counting",
    "claims": [
      {
        "fingerprint": "dominator analysis::top-dominator-type",
        "severity": "Critical",
        "assertion": {
          "predicate": "Retains",
          "measure": {
            "value": 629145600,
            "unit": "Bytes",
            "semantics": "Absolute"
          },
          "reference": {
            "value": {
              "value": 524288000,
              "unit": "Bytes",
              "semantics": "Absolute"
            },
            "basis": "critical threshold"
          },
          "qualifiers": {
            "location": "instances of App.Cache"
          }
        },
        "support": [
          {
            "observations": [
              "observations[0]"
            ],
            "why": "App.Cache is estimated to retain 600 MB across 5,000 instances."
          }
        ],
        "counter": {
          "statements": [
            {
              "observations": [
                "observations[0]"
              ],
              "why": "The retained size is a bounded BFS estimate, not a true dominator tree, so the real figure may be smaller or larger."
            }
          ]
        },
        "falsifiedBy": [
          {
            "kind": "Windbg",
            "test": "On a sampled App.Cache: if its root is a request frame, the instances are short-lived working data, not retained.",
            "command": "!gcroot \u003Cinstance address\u003E"
          },
          {
            "kind": "Windbg",
            "test": "If App.Cache is not among the largest types by total size in !dumpheap -stat, the dominance is wrong.",
            "command": "!dumpheap -stat"
          }
        ]
      },
      {
        "fingerprint": "dominator analysis::highly-referenced-objects",
        "severity": "Critical",
        "assertion": {
          "predicate": "Exhibits",
          "measure": {
            "value": 12,
            "unit": "Count",
            "semantics": "Count"
          },
          "reference": {
            "value": {
              "value": 10,
              "unit": "Count",
              "semantics": "Count"
            },
            "basis": "critical threshold"
          },
          "qualifiers": {
            "location": "objects with abnormally high incoming reference counts"
          }
        },
        "support": [
          {
            "observations": [
              "observations[1]"
            ],
            "why": "12 objects have abnormally high incoming reference counts."
          }
        ],
        "counter": {
          "statements": [],
          "noneFoundBecause": "Reference counting ran to completion and was not capped, so nothing observed qualifies this figure."
        },
        "falsifiedBy": [
          {
            "kind": "Windbg",
            "test": "On a sampled highly referenced object: if its referrers are short-lived, the high count is transient, not a retention hub.",
            "command": "!gcroot \u003Cobject address\u003E"
          }
        ]
      }
    ]
  },
