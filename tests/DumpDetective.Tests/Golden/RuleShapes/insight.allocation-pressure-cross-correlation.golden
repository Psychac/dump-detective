rule: insight.allocation-pressure-cross-correlation
version: 1
[
  {
    "name": "critical-with-blocked-threads",
    "claims": [
      {
        "fingerprint": "insightengine::allocation-pressure-critical",
        "severity": "Critical",
        "assertion": {
          "predicate": "Exceeds",
          "measure": {
            "value": 71,
            "unit": "Custom",
            "semantics": "Ratio"
          },
          "reference": {
            "value": {
              "value": 70,
              "unit": "Custom",
              "semantics": "Ratio"
            },
            "basis": "critical pressure threshold"
          },
          "qualifiers": {
            "mechanism": "Retained allocation profile with many blocked threads",
            "location": "GC pressure score"
          }
        },
        "support": [
          {
            "observations": [
              "observations[0]"
            ],
            "why": "Gen0 holds 10.0% of objects (10.0% of size); the promotion pressure score is 120.00."
          },
          {
            "observations": [
              "observations[1]"
            ],
            "why": "A large share of alive threads is blocked, which GC pauses can contribute to."
          }
        ],
        "counter": {
          "statements": [],
          "noneFoundBecause": "The score combines generation and LOH shares from one snapshot; nothing observed shows whether Gen2 is growing or stable."
        },
        "falsifiedBy": [
          {
            "kind": "Windbg",
            "test": "If the Gen2 and LOH sizes in !eeheap -gc do not match a 80.0% Gen2 object share and 20.0% LOH byte share, the composition is wrong.",
            "command": "!eeheap -gc"
          },
          {
            "kind": "Capture",
            "test": "Capture a second dump under comparable load; if the Gen2 share does not grow, the pressure is steady state, not accumulation."
          }
        ]
      }
    ]
  },
  {
