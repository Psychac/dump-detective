          },
          {
            "observations": [
              "observations[1]"
            ],
            "why": "The finalizer queue holds 2,500 objects."
          }
        ],
        "counter": {
          "statements": [],
          "noneFoundBecause": "High Gen2 and a long finalizer queue are common for reasons unrelated to event subscriptions; their co-occurrence does not show subscriptions cause them."
        },
        "falsifiedBy": [
          {
            "kind": "Windbg",
