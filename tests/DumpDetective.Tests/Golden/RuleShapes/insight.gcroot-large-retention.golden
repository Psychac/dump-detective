          }
        ],
        "counter": {
          "statements": [],
          "noneFoundBecause": "A root that owns the application\u0027s main data structures legitimately retains a large graph; its size alone does not show a leak."
        },
        "falsifiedBy": [
          {
            "kind": "Windbg",
            "test": "If !gcroot on an instance of App.Cache finds a different root, the attribution to this root is wrong.",
            "command": "!gcroot \u003Ctarget address\u003E"
          },
          {
            "kind": "Capture",
            "test": "Capture a second dump under comparable load; if the root\u0027s retained size does not grow, it is a stable working set."
          }
