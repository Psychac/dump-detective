            "command": "!dumpheap -strings"
          },
          {
            "kind": "CodeInspection",
            "test": "If the repeated strings are already interned or pooled at the source, the duplicates are transient copies, not retained waste."
          }
        ]
      }
    ]
  },
  {
    "name": "neither-says-nothing",
