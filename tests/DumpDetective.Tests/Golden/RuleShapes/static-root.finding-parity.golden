rule: static-root.finding-parity
version: 2
[
  {
    "name": "none",
    "claims": []
  },
  {
    "name": "warning",
    "claims": [
      {
        "fingerprint": "static root leak detection::retention-candidates",
        "severity": "Warning",
        "assertion": {
          "predicate": "Retains",
          "measure": {
            "value": 31457280,
            "unit": "Bytes",
            "semantics": "Absolute"
          },
          "qualifiers": {
            "location": "static roots retaining significant object graphs"
          }
        },
        "support": [
          {
            "observations": [
              "observations[0]"
            ],
            "why": "Totals 3 root(s) retaining about 30 MB."
          },
          {
            "observations": [
              "observations[1..3]"
            ],
            "why": "Each is a static root retaining a significant object graph."
          }
        ],
        "counter": {
          "statements": [],
          "noneFoundBecause": "Nothing observed separates a static cache kept on purpose from a static reference that was never cleared; these are candidates, not confirmed leaks."
        },
        "falsifiedBy": [
          {
            "kind": "Windbg",
            "test": "On an instance of the largest retained type: if the path starts at a thread stack or the finalizer queue, not a static handle, the static-root attribution is wrong.",
            "command": "!gcroot \u003Cobject address\u003E"
          },
          {
            "kind": "Capture",
            "test": "Capture a second dump later under comparable load; if the roots still retain about 30 MB and no more, this is a bounded cache, not growth."
          },
          {
            "kind": "CodeInspection",
            "test": "If the owning static field is cleared or replaced on a schedule in the application code, the retention is bounded by design."
          }
        ]
      }
    ]
  },
  {
