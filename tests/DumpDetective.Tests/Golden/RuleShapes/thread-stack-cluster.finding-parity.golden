rule: thread-stack-cluster.finding-parity
version: 1
[
  {
    "name": "low-diversity-no-dominant-cluster",
    "claims": [
      {
        "fingerprint": "thread stack signature clustering::diversity",
        "severity": "Warning",
        "assertion": {
          "predicate": "Dominates",
          "measure": {
            "value": 12.5,
            "unit": "Percent",
            "semantics": "Ratio"
          },
          "reference": {
            "value": {
              "value": 25,
              "unit": "Percent",
              "semantics": "Ratio"
            },
            "basis": "low-diversity threshold"
          },
          "qualifiers": {
            "location": "thread stack-signature diversity"
          }
        },
        "support": [
          {
            "observations": [
              "observations[0]"
            ],
            "why": "5 unique stack signatures across 40 alive threads."
          }
        ],
        "counter": {
          "statements": [],
          "noneFoundBecause": "Idle framework threads also produce low diversity; whether the largest cluster is such a pattern is judged in the dominant-cluster finding."
        },
        "falsifiedBy": [
          {
            "kind": "Windbg",
            "test": "If the managed stacks of the 40 alive threads fall into a number of distinct shapes other than 5, the clustering is wrong.",
            "command": "!eestack"
          },
          {
            "kind": "Capture",
            "test": "Capture a second dump a few minutes later; if the shared signatures are different ones, the low diversity is a transient pile-up, not a standing pattern."
          }
        ]
      }
    ]
  },
  {
    "name": "low-diversity-application-hotspot",
    "claims": [
      {
        "fingerprint": "thread stack signature clustering::diversity",
        "severity": "Warning",
        "assertion": {
          "predicate": "Dominates",
          "measure": {
            "value": 20,
